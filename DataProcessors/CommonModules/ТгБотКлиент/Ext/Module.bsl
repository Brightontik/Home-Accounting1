// Возвращает токен Telegram-бота из констант или пустую строку при ошибке
//
// Возвращаемое значение:
//   Строка - токен Telegram-бота
//   - Неопределено - если токен не заполнен
Функция ПолучитьТокенБота() Экспорт
	Токен = Константы.ТокенТГБота.Получить();
	Если ПустаяСтрока(Токен) Тогда
		ЗаписьЖурналаРегистрации("Ошибка_Тг",,,,"Токен не заполнен");
		Возврат "";
	КонецЕсли;
	Возврат Токен;
КонецФункции

// Выполняет запрос к API Telegram для получения обновлений, начиная с указанного смещения.
//
// Возвращаемое значение:
//   Строка - JSON-строка с результатом запроса при успешном выполнении
//   - Неопределено - пустая строка при возникновении ошибки или неуспешном коде ответа
Функция ПолучитьОбновленияБота()  Экспорт
	
	ПоследнийID = Константы.ПоследнийНомерСообщенияТГ.Получить();
	
	Токен = ПолучитьТокенБота();
	ПараметрOffset = ?(ПоследнийID=0, "", "&offset=" + Формат(ПоследнийID, "ЧГ=0"));
	
	Таймаут = ТгБотСервисы.ТаймаутТелеграмAPI();
	Ресурс = "bot" + Токен + "/getUpdates?timeout=" + Формат(Таймаут, "ЧГ=0") + ПараметрOffset;
	
	Попытка
		ТаймаутСоединения= ТгБотСервисы.ТаймаутHTTPСоединения();
		Соединение = Новый HTTPСоединение("api.telegram.org",,,,,,Новый ЗащищенноеСоединениеOpenSSL());
		Запрос = Новый HTTPЗапрос(Ресурс);
		Ответ = Соединение.Получить(Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			Возврат Ответ.ПолучитьТелоКакСтроку();
		Иначе
			ЗаписьЖурналаРегистрации("Ошибка_ТГ",,,,"Код состояния: " + Ответ.КодСостояния);
			Возврат "";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка_ТГ",,,,ОписаниеОшибки());
		Возврат "";
		КонецПопытки;
	     
	КонецФункции
#Область ОтправкаСообщений
// Отправляет текстовое сообщение в указанный чат через Telegram Bot API
//
// Параметры:
//   ЧатID - Число - идентификатор чата получателя
//   Текст - Строка - текст отправляемого сообщения
Процедура ОтправитьСообщение(ЧатID, Текст) Экспорт
	  Токен = ПолучитьТокенБота();
	 ТекстURL = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
	 Ресурс = "bot" + Токен + "/sendMessage?chat_id=" + Формат(ЧатID, "ЧГ=0") + "&text=" + ТекстURL;
	 
	 Попытка
		 ТаймаутСоединения = ТгБотСервисы.ТаймаутHTTPСоединения();
		 Соединение = Новый HTTPСоединение("api.telegram.org",,,,,, Новый ЗащищенноеСоединениеOpenSSL());
		 Запрос = Новый HTTPЗапрос(Ресурс);
		 Ответ = Соединение.Получить(Запрос);
		 
		 Если Ответ.КодСостояния <> 200 Тогда
			 ЗаписьЖурналаРегистрации("Тг_Ошибка",,,,ОписаниеОшибки());
		 КонецЕсли;
	 Исключение
		 ЗаписьЖурналаРегистрации("Тг_Крит",,,,ОписаниеОшибки());
		 КонецПопытки;
		 

	 КонецПроцедуры
// Отправляет изображение в указанный чат Telegram Bot API.
//
// Параметры:
//   ЧатID - Число - идентификатор чата для отправки
//   ДвоичныеДанныеКартинки - ДвоичныеДанные - изображение для отправки
//   Подпись - Строка - текст сообщения к изображению, по умолчанию пустая строка
Процедура ОтправитьФото(ЧатID, ДвоичныеДанныеКартинки, Подпись = "") Экспорт
	Токен = ПолучитьТокенБота();
	Boundary = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		
	НачалоТела = "--" + Boundary + Символы.ПС +
	             "Content-Disposition: form-data; name=""chat_id""" + Символы.ПС + Символы.ПС +
	             Формат(ЧатID, "ЧГ=0") + Символы.ПС +
	             "--" + Boundary + Символы.ПС +
	             "Content-Disposition: form-data; name=""caption""" + Символы.ПС + Символы.ПС +
	             Подпись + Символы.ПС +
	             "--" + Boundary + Символы.ПС +
	             "Content-Disposition: form-data; name=""photo""; filename=""image.jpg""" + Символы.ПС +
	             "Content-Type: image/jpeg" + Символы.ПС + Символы.ПС;
	
	КонецТела = Символы.ПС + "--" + Boundary + "--" + Символы.ПС;
	
	// 2. Склеиваем всё в один кусок двоичных данных
	// Сначала текст в байты
	ДанныеНачала = ПолучитьДвоичныеДанныеИзСтроки(НачалоТела, КодировкаТекста.UTF8, Ложь);
	ДанныеКонца  = ПолучитьДвоичныеДанныеИзСтроки(КонецТела, КодировкаТекста.UTF8, Ложь);
	
	// Собираем массив из кусочков в правильном порядке
	МассивДляСборки = Новый Массив;
	МассивДляСборки.Добавить(ДанныеНачала);
	МассивДляСборки.Добавить(ДвоичныеДанныеКартинки);
	МассивДляСборки.Добавить(ДанныеКонца);
	
	// Теперь склеиваем массив в один монолитный объект
	РезультатДанные = СоединитьДвоичныеДанные(МассивДляСборки);	
	// 3. Отправляем
	Ресурс = "bot" + Токен + "/sendPhoto";
	Соединение = Новый HTTPСоединение("api.telegram.org", , , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Boundary);
	
	// В 8.3.27 этот метод — базовый
	Запрос.УстановитьТелоИзДвоичныхДанных(РезультатДанные);
	
	Попытка
		Соединение.Отправить(Запрос);
	Исключение
		ЗаписьЖурналаРегистрации("ТГ_ОШИБКА", , , , ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры	 
#КонецОбласти	 

// Скачивает файл изображения из Telegram по идентификатору, создает запись в базе знаний
// с подписью и сохраняет изображение как вложенный файл
//
// Параметры:
//   ФайлID - Строка - идентификатор файла в Telegram
//   ТекстПодписи - Строка - текст подписи к изображению (может содержать хештег)
//   АвторID - Строка - идентификатор пользователя в Telegram
Процедура ОбработатьФотоИзТГ(ФайлID, ТекстПодписи, АвторID) Экспорт
    
    Токен = ПолучитьТокенБота();
    Соединение = Новый HTTPСоединение("api.telegram.org", , , , , , Новый ЗащищенноеСоединениеOpenSSL());
    РесурсПуть = "bot" + СокрЛП(Токен) + "/getFile?file_id=" + СокрЛП(ФайлID);
	ЗапросПуть = Новый HTTPЗапрос(РесурсПуть);
	
	Попытка
		ОтветПуть = Соединение.Получить(ЗапросПуть);
		Если ОтветПуть.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("ТГ_ОШИБКА", , , , "Ошибка getFile: " + ОтветПуть.КодСостояния);
			Возврат;
		КонецЕсли;
		
		// Читаем путь из JSON
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ОтветПуть.ПолучитьТелоКакСтроку());
		ДанныеРезультата = ПрочитатьJSON(ЧтениеJSON);
		ПустьКФайлу = ДанныеРезультата.result.file_path;
		
	Исключение
		ЗаписьЖурналаРегистрации("ТГ_ОШИБКА", , , , "Сеть: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// ЭТАП 2: Скачиваем сам файл
	// Путь в телеграме выглядит так: /file/bot<token>/<file_path>
	РесурсФайл = "file/bot" + СокрЛП(Токен) + "/" + ПустьКФайлу;
	ЗапросФайл = Новый HTTPЗапрос(РесурсФайл);
	
	Попытка
		ОтветФайл = Соединение.Получить(ЗапросФайл);
		
		Если ОтветФайл.КодСостояния = 200 Тогда
			// Получаем картинку сразу в ДвоичныеДанные
			КартинкаДанные = ОтветФайл.ПолучитьТелоКакДвоичныеДанные();
			
			// ЭТАП 3: Создаем записи в 1С
			ТекПользователь = ТгБотСервисы.ОпределитьПользователяПоID(АвторID);
	   ИмяТега = ТгБотСервисы.ОпределитьИмяТегаПоТексту(ТекстПодписи);
	   ТипИнфо = ТгБотСервисы.ОпределитьТипИнформацииПоТексту(ИмяТега);
	   ТекстБезТега = СокрЛП(СтрЗаменить(ТекстПодписи, "#" + ИмяТега, ""));
        НоваяЗаметка = Справочники.БазаЗнаний.СоздатьЭлемент();
        НоваяЗаметка.Наименование = "Фото: " + ?(ПустаяСтрока(ТекстБезТега), ТекущаяДата(), Лев(ТекстБезТега, 50));
        НоваяЗаметка.Содержание = ТекстБезТега;
        НоваяЗаметка.ДатаДобавления = ТекущаяДата();
	   НоваяЗаметка.ТипИнформации = ТипИнфо;
	   НоваяЗаметка.Тег = ИмяТега;
	   НоваяЗаметка.Пользователь = ТекПользователь;
        НоваяЗаметка.Записать();
	   
			// Сохраняем картинку
			НовыйФайл = Справочники.ПрисоединенныеФайлыБазыЗнаний.СоздатьЭлемент();
			НовыйФайл.Владелец = НоваяЗаметка.Ссылка;
			НовыйФайл.Наименование = "image.jpg";
			НовыйФайл.Файл = Новый ХранилищеЗначения(КартинкаДанные);
			НовыйФайл.Записать();
			
			ОтправитьСообщение(АвторID, " Фото сохранено в твой 'Второй мозг'!");
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("ТГ_ОШИБКА", , , , "Ошибка загрузки файла: " + ОписаниеОшибки());
	КонецПопытки;    
   
КонецПроцедуры
	