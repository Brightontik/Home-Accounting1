// Извлекает имя тега из текста, содержащего символ #.
//
// Параметры:
//   ТекстСТегом - Строка - Текст с тегом, содержащим символ #
//
// Возвращаемое значение:
//   Строка - Имя тега в верхнем регистре
Функция ОпределитьИмяТегаПоТексту(ТекстСТегом) Экспорт
    ПозТега = Найти(ТекстСТегом, "#");
    СтрокаПослеРешетки = СокрЛП(Сред(ТекстСТегом, ПозТега + 1));
    ПозПробела = Найти(СтрокаПослеРешетки, " ");
    ИмяТега = ВРег(?(ПозПробела > 0, Лев(СтрокаПослеРешетки, ПозПробела - 1), СтрокаПослеРешетки));
    Возврат ИмяТега;
КонецФункции
//Функция по определению типа тэга
Функция ОпределитьТипИнформацииПоТексту(ИмяТега) Экспорт
    
    Если ИмяТега = "УЧЕБА" Тогда
        Возврат Перечисления.ТипыИнформацииБазыЗнаний.Учеба;
    ИначеЕсли ИмяТега = "ИДЕЯ" Тогда
        Возврат Перечисления.ТипыИнформацииБазыЗнаний.Идея;
    ИначеЕсли ИмяТега = "ССЫЛКА"  Тогда
        Возврат Перечисления.ТипыИнформацииБазыЗнаний.Ссылка;
    Иначе
        Возврат Перечисления.ТипыИнформацииБазыЗнаний.Заметка;
    КонецЕсли;
    
КонецФункции
//Определить пользователя по айди
Функция ОпределитьПользователяПоID(АвторID) Экспорт
	  Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Пользователь
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ТелеграмID = &ТелеграмID
	|	И Пользователи.ВходРазрешен = ИСТИНА";
	Запрос.УстановитьПараметр("ТелеграмID", Формат(АвторID, "ЧГ=0"));
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Пользователь;
	КонецЕсли;
	Возврат Справочники.Пользователи.ПустаяСсылка();
КонецФункции 
//Определить айди по пользователю
Функция ОпределитьIDПоПользователю(ТекПользователь) Экспорт
	Если НЕ ЗначениеЗаполнено(ТекПользователь) Тогда
		Возврат 0;
	КонецЕсли;
	ТелеграмID = ТекПользователь.ТелеграмID;
	Если ПустаяСтрока(ТелеграмID) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(ТелеграмID);
КонецФункции
//Функция помощник календарь
Функция ПолучитьСекундыИзТипаНапоминания(Тип)  Экспорт
	Если Тип = Перечисления.ТипыНапоминаний.За15Минут Тогда Возврат СекундыВ15Минутах();
    ИначеЕсли Тип = Перечисления.ТипыНапоминаний.ЗаЧас Тогда Возврат СекундыВЧасе();
    ИначеЕсли Тип = Перечисления.ТипыНапоминаний.ЗаДень Тогда Возврат СекундыВДне();
    КонецЕсли;
    Возврат 0;
КонецФункции

