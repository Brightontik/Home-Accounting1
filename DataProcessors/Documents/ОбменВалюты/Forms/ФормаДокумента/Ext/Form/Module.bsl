
&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ЗаполнитьКурсНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЗаполнитьКурсНаСервере();
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьКурсНаСервере()
    
    // 1. Проверка на заполнение данных
    Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
        Возврат;
    КонецЕсли;
    
    // Если дата документа не заполнена, берем текущую дату
    ДатаЗапроса = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
    
    // 2. Обработка рубля
    // Проверяем Код (стандартный) или КодВалюты (ваш реквизит), если нужно
    Если Объект.Валюта.Код = "RUB" Или Объект.Валюта.Наименование = "Рубль" Тогда
        Объект.Курс = 1;
        ПересчитатьСуммуВРублях();
        Возврат;
    КонецЕсли;
    
    // 3. Получаем курс через Виртуальную таблицу "СрезПоследних"
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ

    |	КурсыСрезПоследних.Курс КАК Курс
    |ИЗ
    |	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаЗапроса, Валюта = &Валюта) КАК КурсыСрезПоследних";
    
    Запрос.УстановитьПараметр("ДатаЗапроса", ДатаЗапроса);
    Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
    
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Объект.Курс = Выборка.Курс;
    Иначе
        // Если курса в базе нет вообще
        Объект.Курс = 1;
        Сообщить("Курс для валюты " + Объект.Валюта + " не найден в регистре на " + Формат(ДатаЗапроса, "ДФ=dd.MM.yyyy") + ". Установлен курс 1.");
    КонецЕсли;
    
    // 4. Пересчет суммы
    ПересчитатьСуммуВРублях();
    
КонецПроцедуры
&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
    ПересчитатьСуммуВРублях();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуВРублях()
    
    Если Объект.Сумма > 0 И Объект.Курс > 0 Тогда
        Объект.СуммаВРублях = Объект.Сумма * Объект.Курс;
    Иначе
        Объект.СуммаВРублях = 0;
    КонецЕсли;
    
КонецПроцедуры