Процедура ОбработкаПроведения(Отказ, Режим)
	

	Если Количество <= 0 Тогда
		Сообщить("Ошибка: Количество должно быть больше 0!");
		Отказ = Истина;
	КонецЕсли;
	

	// 2. Получаем данные об активе и его курс
	ЗапросДанные = Новый Запрос;
	ЗапросДанные.Текст = 
	"ВЫБРАТЬ

	|	Активы.Валюта КАК ВалютаАктива,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК Курс
	|ИЗ

	|	Справочник.Активы КАК Активы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсыВалютСрезПоследних
	|		ПО Активы.Валюта = КурсыВалютСрезПоследних.Валюта

	|ГДЕ
	|	Активы.Ссылка = &Актив";
	
	ЗапросДанные.УстановитьПараметр("Актив", Актив);
	ЗапросДанные.УстановитьПараметр("Дата", МоментВремени()); 
	
	Выборка = ЗапросДанные.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	ВалютаАктива = Выборка.ВалютаАктива;
	
	КодВалюты = СокрЛП(Валюта.Код);
	ТекущийОстаток = 0;

	ЗапросОстатки = Новый Запрос;
	Если КодВалюты = "RUB" Тогда
		ЗапросОстатки.Текст = 
		"ВЫБРАТЬ

		|	СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенег.Остатки(&МоментВремени, Пользователь = &Пользователь) КАК Остатки";
	Иначе
		ЗапросОстатки.Текст = 
		"ВЫБРАТЬ

		|	СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиВалюты.Остатки(&МоментВремени, Пользователь = &Пользователь И Валюта = &Валюта) КАК Остатки";
		ЗапросОстатки.УстановитьПараметр("Валюта", Валюта);
	КонецЕсли;

	ЗапросОстатки.УстановитьПараметр("МоментВремени", МоментВремени());
	ЗапросОстатки.УстановитьПараметр("Пользователь", Пользователь);

	ВыборкаОстатки = ЗапросОстатки.Выполнить().Выбрать();
	Если ВыборкаОстатки.Следующий() Тогда
		// Исправлено: заменяем ЕСТЬNULL на проверку значения
		ТекущийОстаток = ?(ВыборкаОстатки.СуммаОстаток = Неопределено, 0, ВыборкаОстатки.СуммаОстаток);
	КонецЕсли;

	// Если денег меньше, чем сумма в документе — отменяем проведение
	Если ТекущийОстаток < Сумма Тогда
		Сообщить("Недостаточно средств для покупки! Требуется: " + Сумма + " " + Валюта + ", в наличии: " + ТекущийОстаток);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// 3. Расчет суммы в валюте актива
	СуммаВВалютеАктива = Сумма;
	Если Валюта <> ВалютаАктива Тогда
		СуммаВВалютеАктива = ?(Выборка.Курс <> 0, Сумма / Выборка.Курс, Сумма);
	КонецЕсли;

	// 4. Движения: ОстаткиАктивов
	Движения.ОстаткиАктивов.Записывать = Истина;
	Движение = Движения.ОстаткиАктивов.ДобавитьПриход();
	Движение.Период           = Дата;
	Движение.Актив            = Актив;
	Движение.Пользователь      = Пользователь;
	Движение.Количество       = Количество;
	Движение.СуммаВложений    = СуммаВВалютеАктива; // Ресурс по вашей структуре
	Движение.ТекущаяСтоимость = СуммаВВалютеАктива; // Ресурс по вашей структуре

	// 5. Движения: ОборотыАктивов
	Движения.ОборотыАктивов.Записывать = Истина;
	Движение = Движения.ОборотыАктивов.Добавить();
	Движение.Период             = Дата;
	Движение.Актив              = Актив;
	Движение.Пользователь        = Пользователь;
	Движение.ТипОперации        = Перечисления.ТипОперацииАктивов.Пополнение;
	Движение.ИзменениеКоличества = Количество;
	Движение.ИзменениеСуммы      = СуммаВВалютеАктива;
	Движение.КурсКРублю         = Выборка.Курс; // Ресурс по вашей структуре

	// 6. Движения по деньгам (остатки)
	КодВалюты = СокрЛП(Валюта.Код); 
	
	Если КодВалюты = "RUB" Тогда
        // Оплата в рублях
        Движения.ОстаткиДенег.Записывать = Истина;
        Движение = Движения.ОстаткиДенег.ДобавитьРасход();
        Движение.Период       = Дата;
        Движение.Пользователь  = Пользователь;
        Движение.Сумма        = Сумма;
    Иначе
        // Оплата в любой другой валюте (USD, EUR и т.д.)
        // Теперь движение будет всегда, если это не рубль
        Движения.ОстаткиВалюты.Записывать = Истина;
        Движение = Движения.ОстаткиВалюты.ДобавитьРасход();
        Движение.Период       = Дата;
        Движение.Пользователь  = Пользователь;
        Движение.Валюта       = Валюта;
        Движение.Сумма        = Сумма;
   КонецЕсли;
   
КонецПроцедуры

