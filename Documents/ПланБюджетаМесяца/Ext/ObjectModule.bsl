Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	БюджетПланированиеСервер.ПересчитатьПланДокумента(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// 1. Пересчитываем план перед записью движений
	БюджетПланированиеСервер.ПересчитатьПланДокумента(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// 2. Факт на дату проведения
	ФактКатегории = БюджетПланированиеСервер.ПолучитьФактКатегорииНаДату(Пользователь, МесяцПлана, Дата);
	ФактАктивы    = БюджетПланированиеСервер.ПолучитьФактАктивыНаДату(Пользователь, МесяцПлана, Дата);
	ФактВалюты    = БюджетПланированиеСервер.ПолучитьФактВалютыНаДату(Пользователь, МесяцПлана, Дата);

	// 3. Плановые агрегаты
	ПланКатегории = 0;
	Для Каждого СтрКат Из ПланПоКатегориям Цикл
		ПланКатегории = ПланКатегории + ?(ЗначениеЗаполнено(СтрКат.Сумма), СтрКат.Сумма, 0);
	КонецЦикла;

		ПланКатегории = 0;
	Для Каждого СтрКат Из ПланПоКатегориям Цикл
		ПланКатегории = ПланКатегории + ?(ЗначениеЗаполнено(СтрКат.Сумма), СтрКат.Сумма, 0);
	КонецЦикла;

	ОстатокПослеКатегорий = ДоступноКПланированию - ПланКатегории;
	Если ОстатокПослеКатегорий < 0 Тогда
		Сообщить("Категории превышают доступный бюджет.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПланАктивы = Окр(ОстатокПослеКатегорий * 0.7, 2);
	ПланВалюты = ОстатокПослеКатегорий - ПланАктивы;
	
	// 4. Движение в регистр сведений итогов
	Движения.ИтогиПланаМесяца.Записывать = Истина;
	Движения.ИтогиПланаМесяца.Очистить();

	Запись = Движения.ИтогиПланаМесяца.Добавить();
	Запись.Период = НачалоМесяца(МесяцПлана); // если регистр периодический по месяцу
	Запись.Пользователь = Пользователь;
	Запись.Месяц = НачалоМесяца(МесяцПлана);

	Запись.Доход = ДоходМесяца;
	Запись.Обязательные = ОбязательныеТратыИтого;
	Запись.ПланКатегории = ПланКатегории;
	Запись.ПланАктивы = ПланАктивы;
	Запись.ПланВалюты = ПланВалюты;

	Запись.ФактКатегорииНаДату = ФактКатегории;
	Запись.ФактАктивыНаДату = ФактАктивы;
	Запись.ФактВалютыНаДату = ФактВалюты;

	Запись.Нераспределено = Нераспределено;
	Запись.ДатаРасчетаФакта = Дата;

КонецПроцедуры