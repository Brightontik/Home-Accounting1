Процедура ОбработкаПроведения(Отказ, Режим)
    
    
    Если Сумма <= 0 Тогда
        Сообщить("Ошибка: Сумма должна быть больше 0!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    // ===== 1. Регистр "ОстаткиВалюты" =====
    Движения.ОстаткиВалюты.Записывать = Истина;
    Движения.ОстаткиВалюты.Очистить();
    
    Движение = Движения.ОстаткиВалюты.Добавить();
    
    // Определяем вид движения
    Если ТипОперации = Перечисления.ТипыВалютныхОпераций.Покупка 
        ИЛИ ТипОперации = Перечисления.ТипыВалютныхОпераций.Пополнение Тогда
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Иначе
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    КонецЕсли;
    
    Движение.Период = Дата;
    Движение.Пользователь = Пользователь;
    Движение.Валюта = Валюта;
    Движение.Сумма = Сумма;
    
    // ===== 2. Регистр "ОборотыВалюты" =====
    Движения.ОборотыВалюты.Записывать = Истина;
    Движения.ОборотыВалюты.Очистить();
    
    Движение = Движения.ОборотыВалюты.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период = Дата;
    Движение.Пользователь = Пользователь;
    Движение.Валюта = Валюта;
    Движение.ТипОперации = ТипОперации;
    Движение.Сумма = Сумма;
    Движение.СуммаВРублях = СуммаВРублях;
    
    // ===== 3. Если операция связана с рублевым счетом =====
    Если ТипОперации = Перечисления.ТипыВалютныхОпераций.Покупка 
        ИЛИ ТипОперации = Перечисления.ТипыВалютныхОпераций.Изъятие Тогда
        
        // Уменьшаем рублевый остаток
        Движения.ОстаткиДенег.Записывать = Истина;
        Движения.ОстаткиДенег.Очистить();
        
        ДвижениеРуб = Движения.ОстаткиДенег.Добавить();
        ДвижениеРуб.ВидДвижения = ВидДвиженияНакопления.Расход;
        ДвижениеРуб.Период = Дата;
        ДвижениеРуб.Пользователь = Пользователь;
        ДвижениеРуб.Сумма = СуммаВРублях;
        
    КонецЕсли;
    
    Если ТипОперации = Перечисления.ТипыВалютныхОпераций.Пополнение Тогда
        // Увеличиваем рублевый остаток при продаже валюты
        Движения.ОстаткиДенег.Записывать = Истина;
        Движения.ОстаткиДенег.Очистить();
        
        ДвижениеРуб = Движения.ОстаткиДенег.Добавить();
        ДвижениеРуб.ВидДвижения = ВидДвиженияНакопления.Приход;
        ДвижениеРуб.Период = Дата;
        ДвижениеРуб.Пользователь = Пользователь;
        ДвижениеРуб.Сумма = СуммаВРублях;
        
    КонецЕсли;
    
КонецПроцедуры     

