Процедура ОбработкаПроведения(Отказ, Режим)
	Если Сумма < 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма не может быть меньше нуля",,"Сумма","Объект",Отказ);
		КонецЕсли;
        
    // Переводим сумму в базовую валюту (RUB) для хранения
    СуммаВРублях = Сумма;
    Если Валюта <> Неопределено И Валюта.Код <> "RUB" Тогда
        СуммаВРублях = Сумма * Курс;
    КонецЕсли;
    
    // Остатки денег (в рублях)
    Движения.ОстаткиДенег.Записывать = Истина;
    Движения.ОстаткиДенег.Очистить();
    
    Движение = Движения.ОстаткиДенег.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    Движение.Период = Дата;
    Движение.Пользователь = Пользователь;
    Движение.Валюта = Справочники.Валюты.НайтиПоКоду("RUB");
    Движение.Сумма = СуммаВРублях;
    
    // Обороты по категориям (в рублях)
    Движения.ОборотыПоКатегориям.Записывать = Истина;
    Движения.ОборотыПоКатегориям.Очистить();
    
    Движение = Движения.ОборотыПоКатегориям.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    Движение.Период = Дата;
    Движение.Пользователь = Пользователь;
    Движение.Категория = Категория;
    Движение.Валюта = Справочники.Валюты.НайтиПоКоду("RUB");
    Движение.Сумма = СуммаВРублях;        
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
           Если ПустаяСтрока(Номер) Тогда   
        // Считаем количество существующих документов
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(Документы.Ссылка) КАК Количество
        |ИЗ
        |    Документ.Расход КАК Документы ";
        
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        
        СледующийНомер = Выборка.Количество + 1;
        
             Префикс = "Расход-";
        Год = Формат(Дата, "ДФ=yyyy");
        Номер = Префикс + Год + "-" + Формат(СледующийНомер, "ЧЦ=6; ЧВН=");
        
       КонецЕсли;
    
КонецПроцедуры
